{
  "name": "@dinego/web",
  "version": "0.1.0",
  "private": true,
  "description": "DineGo web app (Next.js + Tailwind CSS)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint src next.config.ts postcss.config.mjs",
    "lint:fix": "eslint src next.config.ts postcss.config.mjs --fix",
    "clean": "rm -rf .next tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@dinego/shared": "*",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
