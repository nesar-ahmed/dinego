PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN_SECONDS=604800
# HttpOnly session cookie. Set COOKIE_SECURE=true in production (requires HTTPS).
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Optional cookie domain, for example .example.com
# COOKIE_DOMAIN=
# Optional. Defaults to apps/api/dinego.sqlite
# DATABASE_PATH=dinego.sqlite
